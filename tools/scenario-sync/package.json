{
  "name": "scenario-sync",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Validate and generate iOS story content from the Google Sheets source of truth.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node --import tsx src/cli.ts",
    "sync:check": "node --import tsx src/cli.ts --check",
    "sync:write": "node --import tsx src/cli.ts --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --single-quote --print-width 100 --trailing-comma all --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --single-quote --print-width 100 --trailing-comma all --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.14.2",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
