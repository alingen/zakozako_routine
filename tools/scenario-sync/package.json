{
  "name": "scenario-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sync conversation scenarios from Google Sheets (source of truth) into normalized JSON the iOS app reads.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "tsx src/cli.ts",
    "sync:check": "tsx src/cli.ts --check",
    "sync:write": "tsx src/cli.ts --write",
    "make-template": "tsx scripts/make-template.ts",
    "seed": "tsx scripts/seed-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.14.2",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
