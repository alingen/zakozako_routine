# --- scenario-sync configuration ---
# Copy to `.env` (git-ignored) and fill in. Never commit real credentials.

# The Google Spreadsheet ID (the long token in the sheet URL between /d/ and /edit).
SCENARIO_SHEET_ID=1Ifkw0X4TIOxe0f9EpZpZEGIexLg-xoXG8c-ro4I5MBM

# --- Credentials (OPTIONAL) ---
# If the spreadsheet is shared as "anyone with the link can view", NO credentials
# are needed — the tool downloads it via the public XLSX export.
#
# For a private sheet, provide a Google service account (Sheets API enabled,
# sheet shared to the service account email as Viewer). ONE of:
#
# (a) Path to the service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
#
# (b) OR the service account JSON inline (single line). Takes precedence over (a).
# SCENARIO_GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional: override the tab (sheet) names if they differ from the defaults.
# SCENARIO_TAB_SCENARIOS=scenarios
# SCENARIO_TAB_CHOICES=choices
# SCENARIO_TAB_EVENTS=events
